---
import { Code, Tabs, TabItem } from '@astrojs/starlight/components';

const plugin = `claude plugin marketplace add georgeracu/sdd-skills
claude plugin install sdd@georgeracu`;
const npx = `npx skills@latest add georgeracu/sdd-skills`;
const manual = `git clone https://github.com/georgeracu/sdd-skills.git
mkdir -p .claude/skills/sdd
rsync -a --exclude evals sdd-skills/skills/ .claude/skills/sdd/`;
---

<Tabs syncKey="install">
  <TabItem label="Claude Code plugin">
    <Code code={plugin} lang="sh" />
    <p>Recommended for Claude Code. The skills install as <code>/sdd:spec-workflow</code>, <code>/sdd:setup</code> and so on.</p>
  </TabItem>
  <TabItem label="npx skills add">
    <Code code={npx} lang="sh" />
    <p>For other agents, such as Codex or Cursor. This route installs each skill under its bare name, such as <code>spec-generator</code>, without the <code>sdd:</code> prefix that the skills use to call each other.</p>
  </TabItem>
  <TabItem label="Manual copy">
    <Code code={manual} lang="sh" />
    <p>Copy into <code>.agents/skills/sdd/</code> instead for agents that read that layout. Keep the <code>sdd</code> folder, because it gives the skills their prefix.</p>
  </TabItem>
</Tabs>

<p>Choose one route per agent. Two routes install every skill twice.</p>
