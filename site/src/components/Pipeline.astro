---
import pipeline from '../data/pipeline.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const code = (s: string) => s.replace(/`([^`]+)`/g, '<code>$1</code>');
---

<ol class="pipeline">
  {
    pipeline.map((row) => (
      <li class:list={[{ gate: row.gate }]}>
        <span class="step">{row.step}</span>
        <div>
          <strong>
            {row.name ? (
              <a href={`${base}/skills/${row.name}/`}>{row.skill.replace(' (gate)', '')}</a>
            ) : row.href ? (
              <a href={row.href}>{row.skill}</a>
            ) : (
              row.skill
            )}
          </strong>
          {row.gate && <span class="badge">Gate</span>}
          <p set:html={code(row.output)} />
        </div>
      </li>
    ))
  }
</ol>

<style>
  .pipeline { list-style: none; padding: 0; display: grid; gap: 0.5rem; }
  .pipeline li { display: flex; gap: 0.75rem; align-items: flex-start; padding: 0.6rem 0.8rem; border: 1px solid var(--sl-color-gray-5); border-radius: 0.5rem; margin: 0; }
  .pipeline li.gate { border-color: var(--sl-color-accent); background: var(--sl-color-accent-low); }
  .step { flex: none; width: 1.8rem; height: 1.8rem; border-radius: 50%; display: grid; place-items: center; font-weight: 600; background: var(--sl-color-gray-6); }
  .badge { margin-inline-start: 0.5rem; font-size: var(--sl-text-xs); font-weight: 600; text-transform: uppercase; padding: 0.1rem 0.4rem; border-radius: 0.25rem; background: var(--sl-color-accent); color: var(--sl-color-black); }
  .pipeline p { margin: 0.2rem 0 0; font-size: var(--sl-text-sm); color: var(--sl-color-gray-2); }
</style>
